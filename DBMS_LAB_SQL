SELECT 
    name,
    salary,
    bonus,

   
    (salary + COALESCE(bonus, 0))              AS total_compensation, 
    (salary - 5000.00)                        AS salary_deduction,   
    (salary * 1.10)                           AS projected_raise,    
    (salary / 12)                             AS monthly_salary,    
    (emp_id % 2)                              AS is_odd_id,          

    (status_flags & 2)                        AS bitwise_and_fulltime,
    (status_flags | 8)                        AS bitwise_or_flagged,  
    (status_flags ^ 1)                        AS bitwise_xor_toggle,   
    (~status_flags)                           AS bitwise_not,         
    (status_flags << 1)                       AS bitwise_shift_left,   
    (status_flags >> 1)                       AS bitwise_shift_right   

FROM employees
WHERE 

    salary > 40000.00                       
    AND salary >= 45000.00                    
    AND salary < 120000.00                    
    AND salary <= 100000.00                 
    AND department != 'Marketing'            
    AND department <> 'Sales'               

 
    AND (
        department = 'Engineering' 
        OR department = 'Finance'
    )
    AND NOT (emp_id = 99)


    AND salary BETWEEN 45000.00 AND 100000.00


    AND department IN ('Engineering', 'Finance', 'HR')


    AND name LIKE '%e%'                  
    AND name NOT LIKE 'Z%'                   


    AND (bonus IS NOT NULL OR bonus IS NULL)


    AND EXISTS (
        SELECT 1 
        FROM employees e2 
        WHERE e2.manager_id = employees.emp_id
    )

    AND salary > ANY (
        SELECT salary 
        FROM employees 
        WHERE department = 'HR'
    )
    AND salary < ALL (
        SELECT 200000.00
    );